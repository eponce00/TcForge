<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><GVL Name="GVL_HW" Id="{e0000001-0000-0000-0000-000000000001}"><Declaration><![CDATA[// Application-owned process image. No terminals are linked in the test/example solution.
// Derive quality from the IO adapter diagnostics; never hardcode GOOD on hardware.
{attribute 'qualified_only'}
VAR_GLOBAL
    clampAdvanced AT %I* : BOOL;
    clampRetracted AT %I* : BOOL;
    shutdownConfirmed AT %I* : BOOL;
    clampAdvance AT %Q* : BOOL;
    clampRetract AT %Q* : BOOL;
    inputQuality : TcForge.E_IO_Quality := TcForge.E_IO_Quality.UNKNOWN;
    outputQuality : TcForge.E_IO_Quality := TcForge.E_IO_Quality.UNKNOWN;
    shutdownQuality : TcForge.E_IO_Quality := TcForge.E_IO_Quality.UNKNOWN;
END_VAR]]></Declaration></GVL></TcPlcObject>