<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_OutputRestart_Probe" Id="{4f3e7396-ab54-44cb-a5c1-33bc388dbff8}">
    <Declaration><![CDATA[// Injects a previously persisted value into an otherwise fresh instance.
// This tests startup policy, NOT actual TwinCAT persistent-image durability.
FUNCTION_BLOCK FB_OutputRestart_Probe EXTENDS TcForge.FB_DigitalOutput
VAR_INPUT
    simulatedBootDataLoaded : BOOL := TRUE;
    simulatedOldBootData : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Method Name="SeedSavedCommand" Id="{655e24da-4f02-40fd-b3a9-88e305a873c9}">
      <Declaration><![CDATA[METHOD PUBLIC SeedSavedCommand
VAR_INPUT
    value : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_savedCommand := value;
_savedCommandValid := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SimulateStartup" Id="{c5c4252f-03cb-438c-b315-590474ab1bd2}"><Declaration><![CDATA[// Policy probe: reset volatile arming only; not a runtime/persistent-image test.
METHOD PUBLIC SimulateStartup]]></Declaration><Implementation><ST><![CDATA[_startup := TRUE;
_commandReceived := FALSE;
_armed := FALSE;
_forceSafe := FALSE;
_safeRequested := FALSE;
_requestSync := FALSE;]]></ST></Implementation></Method>
    <Method Name="_HasTrustedPersistentImage" Id="{aee6b7d4-56b9-4e26-929b-e8c3642bba2e}"><Declaration><![CDATA[METHOD PROTECTED _HasTrustedPersistentImage : BOOL]]></Declaration><Implementation><ST><![CDATA[// Local probe inputs only: never mutate TwinCAT system information.
_HasTrustedPersistentImage := simulatedBootDataLoaded AND NOT simulatedOldBootData;]]></ST></Implementation></Method>
  </POU>
</TcPlcObject>
