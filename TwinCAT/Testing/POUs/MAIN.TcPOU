    simulation : FB_SimulationBridge;
    operatorMailbox : FB_OperatorMailbox_Test;
    rpcOutput : TcForge.FB_DigitalOutput;
    rpcUninitialized : TcForge.FB_DigitalOutput;
    enableRpcPump : BOOL := TRUE;
    commandValidation : FB_CommandValidation_Test;
    rpcContext : FB_RpcContext_Probe;
    referenceMachine : FB_ReferenceMachine_Test;
    sequenceIntegrity : FB_SequenceIntegrity_Test;
    foundation : FB_Foundation_Test;
    cyclicFoundation : FB_CyclicFoundation_Test;
    fbValidateRequester_Test : FB_F_ValidateRequester_Test;
    fbBitMatrix64_Test       : FB_BitMatrix64_Test;
    fbPermissives_Test       : FB_Permissives_Test;
    fbInterlock_Test         : FB_Interlock_Test;
    fbAlarmSimple_Test       : FB_AlarmSimple_Test;
    fbAlarmLimit_Test        : FB_AlarmLimit_Test;
    fbDeviceBase_Test        : FB_DeviceBase_Test;
    fbLpfFirstOrder_Test     : FB_LPF_FirstOrder_IIR_Test;
    fbDigitalOutput_Test     : FB_DigitalOutput_Test;
    fbDigitalInput_Test      : FB_DigitalInput_Test;
    fbTwoPosActuator_Test    : FB_TwoPosActuator_Test;
    fbAnalogInput_Test       : FB_AnalogInput_Test;
    fbAnalogOutput_Test      : FB_AnalogOutput_Test;
