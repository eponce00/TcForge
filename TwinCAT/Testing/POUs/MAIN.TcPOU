    fbStep_Test              : FB_Step_Test;
    fbStateMachine_Test      : FB_StateMachine_Test;
END_VAR
]]>
    </Declaration>
    <Implementation>
      <ST><![CDATA[simulation();
rpcContext();
IF enableRpcPump THEN rpcOutput(); END_IF;
TcUnit.RUN();
]]>
