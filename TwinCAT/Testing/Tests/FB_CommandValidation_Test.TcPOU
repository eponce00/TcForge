device14();
AssertTrue(Condition := device14.outSignal, Message := 'Rejected command cannot change output intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="DigitalResetRejectsInvalidIdentity" Id="{6b6e7829-179d-4f1e-a097-6cf84ead778b}"><Declaration><![CDATA[METHOD DigitalResetRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalResetRejectsInvalidIdentity');
device15.SetOn(); device15();
rsp := device15.Reset(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device15();
AssertTrue(Condition := device15.outSignal, Message := 'Rejected command cannot change output intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="AnalogSetValueRejectsInvalidIdentity" Id="{a999a821-8535-4f1b-bfa8-30612bab0de9}"><Declaration><![CDATA[METHOD AnalogSetValueRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('AnalogSetValueRejectsInvalidIdentity');
device16.SetValue(rValue := 25.0); device16();
rsp := device16.SetValue(rValue := 80.0, eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device16();
AssertEquals_REAL(Expected := 25.0, Actual := device16.sts.commanded, Delta := 0.001, Message := 'Rejected request preserves commanded value');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="AnalogForceSafeRejectsInvalidIdentity" Id="{d86f0be7-1ffe-4ad9-9910-0cd4a2a5809a}"><Declaration><![CDATA[METHOD AnalogForceSafeRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('AnalogForceSafeRejectsInvalidIdentity');
device17.SetValue(rValue := 25.0); device17();
rsp := device17.ForceSafe(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device17();
AssertEquals_REAL(Expected := 25.0, Actual := device17.sts.commanded, Delta := 0.001, Message := 'Rejected request preserves commanded value');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="AnalogResetRejectsInvalidIdentity" Id="{37e00e5a-c355-476f-b606-a9cb09b99cd7}"><Declaration><![CDATA[METHOD AnalogResetRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('AnalogResetRejectsInvalidIdentity');
device18.SetValue(rValue := 25.0); device18();
rsp := device18.Reset(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device18();
AssertEquals_REAL(Expected := 25.0, Actual := device18.sts.commanded, Delta := 0.001, Message := 'Rejected request preserves commanded value');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="BaseResetRejectsInvalidIdentity" Id="{458aff2d-c453-4a9f-8551-e0e83c2efbab}"><Declaration><![CDATA[METHOD BaseResetRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('BaseResetRejectsInvalidIdentity');
device19.ProbeRaise(code := 42, source := 'TEST', reason := 'Preserve fault');
rsp := device19.Reset(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
AssertEquals_DINT(Expected := 42, Actual := device19.GetFaultCode(), Message := 'Rejected reset preserves fault');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="AlarmAckRejectsInvalidIdentity" Id="{e6c9f693-67e4-4cf9-b228-a1769b854028}"><Declaration><![CDATA[METHOD AlarmAckRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('AlarmAckRejectsInvalidIdentity');

rsp := device20.Ack(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');

TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="LimitAlarmAckRejectsInvalidIdentity" Id="{37622f01-4a66-4206-82b4-926c1a155d76}"><Declaration><![CDATA[METHOD LimitAlarmAckRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('LimitAlarmAckRejectsInvalidIdentity');

rsp := device21.Ack(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');

TEST_FINISHED();]]></ST></Implementation></Method>
</POU></TcPlcObject>
