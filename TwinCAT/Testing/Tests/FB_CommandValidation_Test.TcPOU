device13();
AssertTrue(Condition := device13.outSignal, Message := 'Rejected command cannot change output intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="DigitalForceSafeRejectsInvalidIdentity" Id="{977c5740-c6a5-43a2-a7c7-5dcb0867482b}"><Declaration><![CDATA[METHOD DigitalForceSafeRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalForceSafeRejectsInvalidIdentity');
