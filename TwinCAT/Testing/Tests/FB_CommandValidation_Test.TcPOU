device3();
AssertEquals_DINT(Expected := TcForge.E_SM_State.HOMING, Actual := device3.Status.State, Message := 'Rejected request preserves queued Home');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="SequenceRetryRejectsInvalidIdentity" Id="{00a3b91d-d850-4a16-bb93-49fd2fe6dc61}"><Declaration><![CDATA[METHOD SequenceRetryRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('SequenceRetryRejectsInvalidIdentity');
