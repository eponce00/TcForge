<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><POU Name="FB_CommandValidation_Test" Id="{18abafd1-bc41-40f2-94f1-1901e2fe1e9e}"><Declaration><![CDATA[FUNCTION_BLOCK FB_CommandValidation_Test EXTENDS TcUnit.FB_TestSuite
VAR
    done : BOOL;
    raw : DINT := 99;
    invalid : POINTER TO TcForge.E_Requester;
    rsp : TcForge.E_RpcMethodResponse;
    device0 : FB_StateMachine_Probe;
    device1 : FB_StateMachine_Probe;
    device2 : FB_StateMachine_Probe;
    device3 : FB_StateMachine_Probe;
    device4 : FB_StateMachine_Probe;
    device5 : FB_StateMachine_Probe;
    device6 : FB_StateMachine_Probe;
    device7 : FB_StateMachine_Probe;
    device8 : TcForge.FB_TwoPosActuator;
    device9 : TcForge.FB_TwoPosActuator;
    device10 : TcForge.FB_TwoPosActuator;
    device11 : TcForge.FB_TwoPosActuator;
    device12 : TcForge.FB_DigitalOutput;
    device13 : TcForge.FB_DigitalOutput;
    device14 : TcForge.FB_DigitalOutput;
    device15 : TcForge.FB_DigitalOutput;
    device16 : TcForge.FB_AnalogOutput;
    device17 : TcForge.FB_AnalogOutput;
    device18 : TcForge.FB_AnalogOutput;
    device19 : FB_DeviceBase_Probe;
    device20 : TcForge.FB_AlarmSimple;
    device21 : TcForge.FB_AlarmLimit;
END_VAR]]></Declaration><Implementation><ST><![CDATA[IF done THEN RETURN; END_IF;
invalid := ADR(raw);
SequenceHomeRejectsInvalidIdentity();
SequenceStartRejectsInvalidIdentity();
SequencePauseRejectsInvalidIdentity();
SequenceProceedRejectsInvalidIdentity();
SequenceRetryRejectsInvalidIdentity();
SequenceStopRejectsInvalidIdentity();
SequenceAbortRejectsInvalidIdentity();
SequenceResetRejectsInvalidIdentity();
ActuatorAdvanceRejectsInvalidIdentity();
ActuatorRetractRejectsInvalidIdentity();
ActuatorAbortRejectsInvalidIdentity();
ActuatorResetRejectsInvalidIdentity();
DigitalSetOnRejectsInvalidIdentity();
DigitalSetOffRejectsInvalidIdentity();
DigitalForceSafeRejectsInvalidIdentity();
DigitalResetRejectsInvalidIdentity();
AnalogSetValueRejectsInvalidIdentity();
AnalogForceSafeRejectsInvalidIdentity();
AnalogResetRejectsInvalidIdentity();
BaseResetRejectsInvalidIdentity();
AlarmAckRejectsInvalidIdentity();
LimitAlarmAckRejectsInvalidIdentity();
done := TRUE;]]></ST></Implementation><Method Name="SequenceHomeRejectsInvalidIdentity" Id="{12e512a0-6259-45d4-a7fa-1f9166addaf4}"><Declaration><![CDATA[METHOD SequenceHomeRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('SequenceHomeRejectsInvalidIdentity');
device0.ResetAll(); device0(); rsp := device0.Home();
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.ACCEPTED, Actual := rsp, Message := 'Valid Home queued before rejected request');
rsp := device0.Home(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device0();
AssertEquals_DINT(Expected := TcForge.E_SM_State.HOMING, Actual := device0.Status.State, Message := 'Rejected request preserves queued Home');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="SequenceStartRejectsInvalidIdentity" Id="{d7672a72-7d0a-465d-a863-33a323208802}"><Declaration><![CDATA[METHOD SequenceStartRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('SequenceStartRejectsInvalidIdentity');
device1.ResetAll(); device1(); rsp := device1.Home();
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.ACCEPTED, Actual := rsp, Message := 'Valid Home queued before rejected request');
rsp := device1.Start(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device1();
AssertEquals_DINT(Expected := TcForge.E_SM_State.HOMING, Actual := device1.Status.State, Message := 'Rejected request preserves queued Home');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="SequencePauseRejectsInvalidIdentity" Id="{eec73760-94e5-4118-8a6a-97e71376495c}"><Declaration><![CDATA[METHOD SequencePauseRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('SequencePauseRejectsInvalidIdentity');
