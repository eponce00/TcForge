device9();
AssertTrue(Condition := device9.outAdvance AND NOT device9.outRetract, Message := 'Rejected command cannot change motion');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="ActuatorAbortRejectsInvalidIdentity" Id="{8f8faab5-a0bd-4364-9ad2-d8dff4925c5f}"><Declaration><![CDATA[METHOD ActuatorAbortRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('ActuatorAbortRejectsInvalidIdentity');
