<Method Name="DigitalSetOnRejectsInvalidIdentity" Id="{f81dc806-79c5-4fc5-813d-ea42f8e25715}"><Declaration><![CDATA[METHOD DigitalSetOnRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalSetOnRejectsInvalidIdentity');
device12();
rsp := device12.SetOn(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device12();
AssertTrue(Condition := NOT device12.outSignal, Message := 'Rejected command cannot change output intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="DigitalSetOffRejectsInvalidIdentity" Id="{0b7d2988-da29-43e5-80e4-3c66df2ee451}"><Declaration><![CDATA[METHOD DigitalSetOffRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalSetOffRejectsInvalidIdentity');
