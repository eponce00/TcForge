<Method Name="ActuatorAdvanceRejectsInvalidIdentity" Id="{9aaf77f2-f63f-41cf-bead-c1b5c62ac8c4}"><Declaration><![CDATA[METHOD ActuatorAdvanceRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('ActuatorAdvanceRejectsInvalidIdentity');
device8(inRetracted := TRUE); device8.Advance(); device8();
rsp := device8.Advance(eRequester := invalid^);
AssertEquals_DINT(Expected := TcForge.E_RpcMethodResponse.REJECTED_INVALID_PARAMETER, Actual := rsp, Message := 'Invalid identity must reject before device-specific logic');
device8();
AssertTrue(Condition := device8.outAdvance AND NOT device8.outRetract, Message := 'Rejected command cannot change motion');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="ActuatorRetractRejectsInvalidIdentity" Id="{768dbaef-6a13-48c5-a282-9da127825bd4}"><Declaration><![CDATA[METHOD ActuatorRetractRejectsInvalidIdentity]]></Declaration><Implementation><ST><![CDATA[TEST('ActuatorRetractRejectsInvalidIdentity');
