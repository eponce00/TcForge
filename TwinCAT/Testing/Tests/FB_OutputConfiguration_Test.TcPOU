<Method Name="DigitalBackupImageRejected" Id="{0f5a859f-4cad-414a-8165-ac8a738f02c4}"><Declaration><![CDATA[METHOD PRIVATE DigitalBackupImageRejected]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalBackupImageRejected');
trustDigitalBackupImageRejected.cfg.restoreCommandOnRestart := TRUE;
trustDigitalBackupImageRejected.cfg.invert := TRUE;
trustDigitalBackupImageRejected.SeedSavedCommand(value := FALSE);
trustDigitalBackupImageRejected.simulatedBootDataLoaded := TRUE;
trustDigitalBackupImageRejected.simulatedOldBootData := TRUE;
trustDigitalBackupImageRejected();
AssertTrue(trustDigitalBackupImageRejected.sts.outputInhibited, 'Untrusted persistent image cannot restore output');
AssertFalse(trustDigitalBackupImageRejected.outSignal, 'Electrical output honors startup trust');
trustDigitalBackupImageRejected.simulatedBootDataLoaded := TRUE; trustDigitalBackupImageRejected.simulatedOldBootData := FALSE;
trustDigitalBackupImageRejected.SimulateStartup(); trustDigitalBackupImageRejected();
AssertTrue(trustDigitalBackupImageRejected.sts.outputInhibited, 'Later trust cannot revive previously rejected saved intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="DigitalMissingImageRejected" Id="{b8ac2919-9c93-437d-bb95-77ae53288589}"><Declaration><![CDATA[METHOD PRIVATE DigitalMissingImageRejected]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalMissingImageRejected');
trustDigitalMissingImageRejected.cfg.restoreCommandOnRestart := TRUE;
trustDigitalMissingImageRejected.cfg.invert := TRUE;
trustDigitalMissingImageRejected.SeedSavedCommand(value := FALSE);
trustDigitalMissingImageRejected.simulatedBootDataLoaded := FALSE;
trustDigitalMissingImageRejected.simulatedOldBootData := FALSE;
trustDigitalMissingImageRejected();
AssertTrue(trustDigitalMissingImageRejected.sts.outputInhibited, 'Untrusted persistent image cannot restore output');
AssertFalse(trustDigitalMissingImageRejected.outSignal, 'Electrical output honors startup trust');
trustDigitalMissingImageRejected.simulatedBootDataLoaded := TRUE; trustDigitalMissingImageRejected.simulatedOldBootData := FALSE;
trustDigitalMissingImageRejected.SimulateStartup(); trustDigitalMissingImageRejected();
AssertTrue(trustDigitalMissingImageRejected.sts.outputInhibited, 'Later trust cannot revive previously rejected saved intent');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="DigitalFreshCommandWithUntrustedImage" Id="{e9db745b-6ab2-4540-8253-065aaf13c744}"><Declaration><![CDATA[METHOD PRIVATE DigitalFreshCommandWithUntrustedImage]]></Declaration><Implementation><ST><![CDATA[TEST('DigitalFreshCommandWithUntrustedImage');
trustDigitalFreshCommandWithUntrustedImage.cfg.restoreCommandOnRestart := TRUE;
trustDigitalFreshCommandWithUntrustedImage.cfg.invert := TRUE;
trustDigitalFreshCommandWithUntrustedImage.SeedSavedCommand(value := FALSE);
trustDigitalFreshCommandWithUntrustedImage.simulatedBootDataLoaded := TRUE;
trustDigitalFreshCommandWithUntrustedImage.simulatedOldBootData := TRUE;
trustDigitalFreshCommandWithUntrustedImage.SetOff();
trustDigitalFreshCommandWithUntrustedImage();
AssertFalse(trustDigitalFreshCommandWithUntrustedImage.sts.outputInhibited, 'Fresh command is independent of image trust');
AssertTrue(trustDigitalFreshCommandWithUntrustedImage.outSignal, 'Electrical output honors startup trust');
trustDigitalFreshCommandWithUntrustedImage.simulatedBootDataLoaded := TRUE; trustDigitalFreshCommandWithUntrustedImage.simulatedOldBootData := FALSE;
trustDigitalFreshCommandWithUntrustedImage.SimulateStartup(); trustDigitalFreshCommandWithUntrustedImage();
AssertFalse(trustDigitalFreshCommandWithUntrustedImage.sts.outputInhibited, 'Fresh command remains valid for later trusted restoration');
TEST_FINISHED();]]></ST></Implementation></Method>
<Method Name="AnalogBackupImageRejected" Id="{d288710f-ab38-4932-80ff-56a12a28a947}"><Declaration><![CDATA[METHOD PRIVATE AnalogBackupImageRejected]]></Declaration><Implementation><ST><![CDATA[TEST('AnalogBackupImageRejected');
trustAnalogBackupImageRejected.cfg.restoreCommandOnRestart := TRUE;
trustAnalogBackupImageRejected.cfg.useRawValue := TRUE; trustAnalogBackupImageRejected.cfg.safeRaw := 17.0;
trustAnalogBackupImageRejected.SeedSavedCommand(value := 42.0);
trustAnalogBackupImageRejected.simulatedBootDataLoaded := TRUE;
trustAnalogBackupImageRejected.simulatedOldBootData := TRUE;
trustAnalogBackupImageRejected();
AssertTrue(trustAnalogBackupImageRejected.sts.outputInhibited, 'Untrusted persistent image cannot restore output');
AssertEquals_REAL(17.0, trustAnalogBackupImageRejected.sts.rawReal, 0.001, 'Analog output honors startup trust');
trustAnalogBackupImageRejected.simulatedBootDataLoaded := TRUE; trustAnalogBackupImageRejected.simulatedOldBootData := FALSE;
trustAnalogBackupImageRejected.SimulateStartup(); trustAnalogBackupImageRejected();
AssertTrue(trustAnalogBackupImageRejected.sts.outputInhibited, 'Later trust cannot revive previously rejected saved intent');
TEST_FINISHED();]]></ST></Implementation></Method>
