    <Method Name="ObserveStep" Id="{08387e71-9d75-4f3e-8f78-0828f599f1fe}"><Declaration><![CDATA[METHOD INTERNAL ObserveStep
VAR_INPUT nStep : DINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[IF nStep = Status.Step.Current AND nStep MOD 2 = 0 AND Status.ActiveState THEN
    IF _activeStepCalls < 2 THEN _activeStepCalls := _activeStepCalls + 1; END_IF;
END_IF;]]></ST></Implementation></Method>
    <Method Name="CanExecuteStep" Id="{a29ed26f-3dda-4e67-8817-db5c4f0a3b29}"><Declaration><![CDATA[METHOD INTERNAL CanExecuteStep : BOOL
VAR_INPUT nStep : DINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[CanExecuteStep := nStep = Status.Step.Current AND nStep MOD 2 = 0 AND
    _IsStepInStateRange(state := Status.State, nStep := nStep) AND
    NOT _stepFailurePending AND NOT Status.ShutdownFailed AND
    (NOT IsFaulted() OR Status.State = E_SM_State.STOPPING OR Status.State = E_SM_State.ABORTING);]]></ST></Implementation></Method>
    <Method Name="ValidateStep" Id="{f041e985-e58b-4828-b9c7-fc929ca8b7b7}"><Declaration><![CDATA[METHOD INTERNAL ValidateStep : BOOL
VAR_INPUT nStep : DINT; nDestination : DINT; nTimeout : DINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[ValidateStep := nTimeout >= 0 AND nTimeout <= 356400 AND (nDestination = 0 OR
    (_IsStepInStateRange(state := Status.State, nStep := nDestination) AND nDestination MOD 2 = 0 AND nDestination <> nStep));
IF NOT ValidateStep THEN
    _RaiseStepFault(stepNum := nStep, stepName := Status.Step.Name,
        code := E_SM_Fault.InvalidStepConfiguration, reason := 'Invalid timeout or destination; use zero or another even step in this state');
END_IF;]]></ST></Implementation></Method>
    <Method Name="_DispatchOperatorCommand" Id="{bb32157f-136c-4f9a-aea0-16e72a81cd44}"><Declaration><![CDATA[METHOD PROTECTED _DispatchOperatorCommand : E_RpcMethodResponse
VAR_INPUT command : E_OperatorCommand; value : REAL; END_VAR]]></Declaration><Implementation><ST><![CDATA[CASE command OF
E_OperatorCommand.Home: _DispatchOperatorCommand := THIS^.Home(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Start: _DispatchOperatorCommand := THIS^.Start(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Stop: _DispatchOperatorCommand := THIS^.Stop(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Abort: _DispatchOperatorCommand := THIS^.Abort(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Pause: _DispatchOperatorCommand := THIS^.Pause(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Proceed: _DispatchOperatorCommand := THIS^.Proceed(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Retry: _DispatchOperatorCommand := THIS^.Retry(eRequester := E_Requester.OPERATOR);
ELSE _DispatchOperatorCommand := SUPER^._DispatchOperatorCommand(command := command, value := value);
END_CASE;]]></ST></Implementation></Method>
