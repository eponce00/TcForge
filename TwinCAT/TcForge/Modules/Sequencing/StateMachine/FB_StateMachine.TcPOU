METHOD PUBLIC OperatorAbort : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[OperatorAbort := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Abort, value := 0.0);]]></ST></Implementation>
