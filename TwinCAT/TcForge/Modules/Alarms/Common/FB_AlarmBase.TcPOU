<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_AlarmBase" Id="{a0200000-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[// Abstract base for every FB_Alarm*. Owns the common moving parts:
//   - debounce (TON/TOF) driven by cfg.common.tOnDelay / tOffDelay
//   - latch / ack bookkeeping (VAR PERSISTENT; restoration depends on the
//     application's configured and verified persistent-data saving mechanism)
//   - rising / falling / ack timestamps (LTIME)
//   - program Ack / LockSource methods and queued OperatorAck RPC
//   - the shared ST_Alarm_Sts status surface
//
// Concrete alarms:
//   - EXTEND this FB
//   - declare their own cfg : ST_Alarm<Type>_Cfg (with a nested `common : ST_Alarm_Cfg`)
//     plus any extra signal inputs
//   - compute a raw boolean trip condition from cfg + inputs
//   - call _Evaluate(cfgCommon := cfg.common, bRawCondition := ...) ONCE per
//     cycle from their body
//
// The base deliberately keeps a very small API surface — children should
// never write into sts, the timers, or the latch flags directly.
{attribute 'OPC.UA.DA' := '1'}
FUNCTION_BLOCK ABSTRACT FB_AlarmBase IMPLEMENTS I_Alarm
VAR_OUTPUT
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    sts : ST_Alarm_Sts;
END_VAR
VAR
    {attribute 'OPC.UA.DA' := '0'}
    {attribute 'OPC.UA.DA' := '0'}
    _operatorMailbox : FB_OperatorMailbox;
    {attribute 'OPC.UA.DA' := '0'}
    bSourceLockedToProg : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _ton : TON;
    {attribute 'OPC.UA.DA' := '0'}
    _tof : TON;
    {attribute 'OPC.UA.DA' := '0'}
    _prevDebounced : BOOL;
    _commonKnown : BOOL;
    _previousCommon : ST_Alarm_Cfg;
END_VAR
VAR PERSISTENT
    // A restored latch preserves its acknowledgment state. Restart does not
    // require a second Ack; a restored acknowledged latch still needs valid
    // clear evidence. Persistent-image durability is an application concern.
    _latchedSync : BOOL;
    _ackedSync   : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Abstract base — children provide the cyclic body and call _Evaluate().]]></ST>
    </Implementation>
    <Folder Name="Protected" Id="{a0200000-0000-0000-f000-000000000001}" />
    <Folder Name="Public" Id="{a0200000-0000-0000-f000-000000000002}" />
    <Method Name="_DispatchOperatorCommand" Id="{de106cbb-d23f-472a-848d-c6e80c62921b}">
      <Declaration><![CDATA[METHOD PROTECTED _DispatchOperatorCommand : E_RpcMethodResponse
VAR_INPUT command : E_OperatorCommand; value : REAL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE command OF
E_OperatorCommand.Ack: _DispatchOperatorCommand := THIS^.Ack(eRequester := E_Requester.OPERATOR);
ELSE _DispatchOperatorCommand := E_RpcMethodResponse.REJECTED_INVALID_PARAMETER;
END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_Evaluate" Id="{a0200000-0000-0000-1000-000000000006}" FolderPath="Protected\">
      <Declaration><![CDATA[// Called once per cycle by the concrete child. Takes the child's flattened
// common cfg and the pre-computed raw trip condition, and does the rest:
// debounce → latch/ack → severity → timestamps → sts.
METHOD PROTECTED _Evaluate
VAR_INPUT
    cfgCommon     : ST_Alarm_Cfg;
    bRawCondition : BOOL;
    evaluation : E_AlarmEvaluation := E_AlarmEvaluation.Valid;
    resetTiming : BOOL := FALSE;
END_VAR
VAR changed, severityValid : BOOL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ProcessOperatorCommands();
sts.enabled := cfgCommon.bEnable;
sts.sMessage := cfgCommon.sMessage;
sts.evaluationState := evaluation;
// Explicit disable remains a deliberate suppression/clear operation.
IF NOT cfgCommon.bEnable THEN
    _ton(IN := FALSE); _tof(IN := FALSE);
    _latchedSync := FALSE; _ackedSync := FALSE; _prevDebounced := FALSE;
    sts.raw := FALSE; sts.debounced := FALSE; sts.active := FALSE;
    sts.latched := FALSE; sts.acked := FALSE; sts.eSeverity := E_AlarmSeverity.NONE;
    sts.valid := FALSE; sts.evaluationState := E_AlarmEvaluation.Disabled;
    _previousCommon := cfgCommon; _commonKnown := TRUE;
    RETURN;
END_IF;
// NONE is a legitimate configured severity; reject only unknown enum values.
severityValid := cfgCommon.eSeverity = E_AlarmSeverity.NONE OR cfgCommon.eSeverity = E_AlarmSeverity.INFO OR
    cfgCommon.eSeverity = E_AlarmSeverity.WARNING OR cfgCommon.eSeverity = E_AlarmSeverity.CRITICAL OR
    cfgCommon.eSeverity = E_AlarmSeverity.SHUTDOWN;
IF NOT severityValid THEN
    sts.evaluationState := E_AlarmEvaluation.InvalidConfig;
END_IF;
// A restored latch has no volatile status history yet. Publish its configured
// severity before an invalid-input return; later invalid scans preserve it.
IF NOT _commonKnown AND _latchedSync AND severityValid THEN
    sts.eSeverity := cfgCommon.eSeverity;
END_IF;
changed := _commonKnown AND (cfgCommon.tOnDelay <> _previousCommon.tOnDelay OR
    cfgCommon.tOffDelay <> _previousCommon.tOffDelay OR cfgCommon.bRequireAck <> _previousCommon.bRequireAck);
_previousCommon := cfgCommon; _commonKnown := TRUE;
IF changed OR resetTiming THEN _ton(IN := FALSE); _tof(IN := FALSE); END_IF;
sts.valid := sts.evaluationState = E_AlarmEvaluation.Valid;
IF NOT sts.valid THEN
    // Unknown evidence cannot clear an existing alarm or count toward debounce.
    _ton(IN := FALSE); _tof(IN := FALSE);
    sts.raw := FALSE;
    sts.active := sts.active OR _latchedSync;
    sts.latched := _latchedSync AND NOT _ackedSync;
    sts.acked := _ackedSync;
    RETURN;
END_IF;
sts.raw := bRawCondition;
// Debounce each state transition separately. A held active condition cannot
// disappear merely because its trip timer was reset while evidence was invalid.
IF bRawCondition THEN
    _tof(IN := FALSE);
    IF NOT sts.debounced THEN
        _ton(IN := TRUE, PT := cfgCommon.tOnDelay);
        IF _ton.Q THEN sts.debounced := TRUE; END_IF;
    ELSE _ton(IN := FALSE); END_IF;
ELSE
    _ton(IN := FALSE);
    IF sts.debounced THEN
        _tof(IN := TRUE, PT := cfgCommon.tOffDelay);
        IF _tof.Q THEN sts.debounced := FALSE; END_IF;
    ELSE _tof(IN := FALSE); END_IF;
END_IF;
IF sts.debounced AND NOT _prevDebounced THEN sts.tsTripped := F_Now();
ELSIF NOT sts.debounced AND _prevDebounced THEN sts.tsCleared := F_Now(); END_IF;
_prevDebounced := sts.debounced;
IF cfgCommon.bRequireAck AND sts.debounced AND NOT _latchedSync THEN
    _latchedSync := TRUE; _ackedSync := FALSE;
END_IF;
// Existing latches outlive changes to the policy for future trips.
IF _latchedSync AND _ackedSync AND NOT sts.debounced THEN
    _latchedSync := FALSE; _ackedSync := FALSE;
END_IF;
sts.active := sts.debounced OR _latchedSync;
sts.latched := _latchedSync AND NOT _ackedSync;
sts.acked := _ackedSync;
IF sts.active THEN sts.eSeverity := cfgCommon.eSeverity;
ELSE sts.eSeverity := E_AlarmSeverity.NONE; END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ProcessOperatorCommands" Id="{16247dea-4ff8-4ef6-94f5-3eb31b474695}">
      <Declaration><![CDATA[METHOD PROTECTED _ProcessOperatorCommands
VAR command : E_OperatorCommand; value : REAL; result : E_RpcMethodResponse; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _operatorMailbox.BeginConsume(command => command, value => value) THEN
    result := THIS^._DispatchOperatorCommand(command := command, value := value);
    _operatorMailbox.EndConsume(result := result);
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ack" Id="{a0200000-0000-0000-1000-000000000001}" FolderPath="Public\">
      <Declaration><![CDATA[// Acknowledge the current latch. Idempotent — repeated Acks on the same latch
// just refresh tsAcked / ackRequester. If the condition has already cleared,
// the next cyclic _Evaluate releases the latch.
METHOD PUBLIC Ack : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Ack := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Ack <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
Ack := F_ValidateRequester(
    eRequester    := eRequester,
    bSourceLocked := bSourceLockedToProg,
    bFaulted      := FALSE);

IF Ack = E_RpcMethodResponse.ACCEPTED AND _latchedSync THEN
    _ackedSync        := TRUE;
    sts.ackRequester  := eRequester;
    sts.tsAcked       := F_Now();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LockSource" Id="{a0200000-0000-0000-1000-000000000002}" FolderPath="Public\">
      <Declaration><![CDATA[// When bLock = TRUE, only PROG requesters may Ack(); OPERATOR calls are
// rejected with REJECTED_SOURCE_NOT_ALLOWED. Use for interlock-grade alarms
// that must only be cleared by sequence logic.
METHOD PUBLIC LockSource : E_RpcMethodResponse
VAR_INPUT
    bLock : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bSourceLockedToProg := bLock;
LockSource := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorAck" Id="{d47d4989-6dac-43eb-a474-297767ea3277}">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorAck : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OperatorAck := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Ack, value := 0.0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorCommandResult" Id="{05830c96-98fa-4479-8055-bd7a626b9b74}">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorCommandResult : E_RpcMethodResponse
VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OperatorCommandResult := _operatorMailbox.GetResult(requestId := requestId);]]></ST>
      </Implementation>
    </Method>
<Method Name="_InvalidateEvaluation" Id="{9b1189fa-30d1-49a1-a0b4-3abab7242e58}"><Declaration><![CDATA[METHOD PROTECTED _InvalidateEvaluation
VAR_INPUT evaluation : E_AlarmEvaluation; END_VAR]]></Declaration><Implementation><ST><![CDATA[_ton(IN := FALSE); _tof(IN := FALSE);
sts.valid := FALSE; sts.evaluationState := evaluation; sts.raw := FALSE;
// Preserve established alarm state and timestamps until fresh valid evidence.
]]></ST></Implementation></Method>
  </POU>
</TcPlcObject>
