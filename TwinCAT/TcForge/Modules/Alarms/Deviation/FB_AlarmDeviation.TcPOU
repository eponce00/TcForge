<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="FB_AlarmDeviation" Id="{a0200004-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[// Asymmetric deviation alarm with two operating modes.
//
// Absolute:
//   almRange.cfg.fHighLimit := 95.0;
//   almRange.cfg.fLowLimit  := 10.0;
//   almRange(inpPv := tankLevelPct);
//
// Setpoint deviation (tracks moving setpoints):
//   almDev.cfg.bUseSetpoint := TRUE;
//   almDev.cfg.fHighLimit   := 5.0;       // allow +5 above SP
//   almDev.cfg.fLowLimit    := 3.0;       // allow -3 below SP
//   almDev(inpPv := actualT, inpSetpoint := targetT);
{attribute 'OPC.UA.DA' := '1'}
FUNCTION_BLOCK FB_AlarmDeviation EXTENDS FB_AlarmBase
VAR_INPUT
    // Application quality gate; FALSE means no trustworthy new evidence.
    inpValid : BOOL := TRUE;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    cfg         : ST_AlarmDeviation_Cfg;

    {attribute 'OPC.UA.DA' := '0'}
    inpPv       : REAL;
    {attribute 'OPC.UA.DA' := '0'}
    inpSetpoint : REAL;
END_VAR
VAR
    _criteriaKnown : BOOL;
    _criteriaChanged : BOOL;
    _previousCriteria : ST_AlarmDeviation_Cfg;
    _evaluation : E_AlarmEvaluation;
    _high : LREAL;
    _low : LREAL;
    {attribute 'OPC.UA.DA' := '0'}
    _raw : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_criteriaChanged := FALSE;
IF _criteriaKnown THEN
    IF NOT (F_IsFiniteReal(cfg.fHighLimit) AND F_IsFiniteReal(cfg.fLowLimit) AND F_IsFiniteReal(_previousCriteria.fHighLimit) AND F_IsFiniteReal(_previousCriteria.fLowLimit)) THEN _criteriaChanged := TRUE;
    ELSE _criteriaChanged := cfg.fHighLimit <> _previousCriteria.fHighLimit OR cfg.fLowLimit <> _previousCriteria.fLowLimit OR cfg.bUseSetpoint <> _previousCriteria.bUseSetpoint; END_IF;
END_IF;
_criteriaKnown := TRUE; _previousCriteria := cfg;
_raw := FALSE;
_evaluation := E_AlarmEvaluation.Valid;
IF NOT F_IsFiniteReal(cfg.fHighLimit) OR NOT F_IsFiniteReal(cfg.fLowLimit) THEN
    _evaluation := E_AlarmEvaluation.InvalidConfig;
ELSE
    IF cfg.bUseSetpoint THEN
        IF cfg.fHighLimit < 0.0 OR cfg.fLowLimit < 0.0 THEN _evaluation := E_AlarmEvaluation.InvalidConfig; END_IF;
    ELSIF cfg.fLowLimit > cfg.fHighLimit THEN _evaluation := E_AlarmEvaluation.InvalidConfig;
    END_IF;
END_IF;
IF _evaluation = E_AlarmEvaluation.Valid THEN
    IF NOT inpValid OR NOT F_IsFiniteReal(inpPv) THEN _evaluation := E_AlarmEvaluation.InvalidInput;
    ELSIF cfg.bUseSetpoint AND NOT F_IsFiniteReal(inpSetpoint) THEN _evaluation := E_AlarmEvaluation.InvalidInput;
    END_IF;
END_IF;
IF _evaluation = E_AlarmEvaluation.Valid THEN
    _high := REAL_TO_LREAL(cfg.fHighLimit); _low := REAL_TO_LREAL(cfg.fLowLimit);
    IF cfg.bUseSetpoint THEN
        _high := REAL_TO_LREAL(inpSetpoint) + _high;
        _low := REAL_TO_LREAL(inpSetpoint) - _low;
    END_IF;
    _raw := REAL_TO_LREAL(inpPv) > _high OR REAL_TO_LREAL(inpPv) < _low;
END_IF;
_Evaluate(cfgCommon := cfg.common, bRawCondition := _raw, evaluation := _evaluation, resetTiming := _criteriaChanged);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
