<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="FB_AlarmThreshold" Id="{a0200002-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[// Single-direction threshold alarm over a REAL process value.
//
// Usage (high temp warning with 2s debounce, latching + ack):
//   almHi.cfg.common.bEnable     := TRUE;
//   almHi.cfg.common.tOnDelay    := T#2S;
//   almHi.cfg.common.bRequireAck := TRUE;
//   almHi.cfg.common.eSeverity   := E_AlarmSeverity.WARNING;
//   almHi.cfg.common.sMessage    := 'Reactor T > 80C';
//   almHi.cfg.fThreshold         := 80.0;
//   almHi.cfg.bFailHigh          := TRUE;
//   almHi(inpValue := reactorTempC);
{attribute 'OPC.UA.DA' := '1'}
FUNCTION_BLOCK FB_AlarmThreshold EXTENDS FB_AlarmBase
VAR_INPUT
    // Application quality gate; FALSE means no trustworthy new evidence.
    inpValid : BOOL := TRUE;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    cfg      : ST_AlarmThreshold_Cfg;

    {attribute 'OPC.UA.DA' := '0'}
    inpValue : REAL;
END_VAR
VAR
    _criteriaKnown : BOOL;
    _criteriaChanged : BOOL;
    _previousCriteria : ST_AlarmThreshold_Cfg;
    _evaluation : E_AlarmEvaluation;
    {attribute 'OPC.UA.DA' := '0'}
    _raw : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_criteriaChanged := FALSE;
IF _criteriaKnown THEN
    IF NOT (F_IsFiniteReal(cfg.fThreshold) AND F_IsFiniteReal(_previousCriteria.fThreshold)) THEN _criteriaChanged := TRUE;
    ELSE _criteriaChanged := cfg.fThreshold <> _previousCriteria.fThreshold OR cfg.bFailHigh <> _previousCriteria.bFailHigh OR cfg.bFailLow <> _previousCriteria.bFailLow; END_IF;
END_IF;
_criteriaKnown := TRUE; _previousCriteria := cfg;
_raw := FALSE;
_evaluation := E_AlarmEvaluation.Valid;
IF NOT F_IsFiniteReal(cfg.fThreshold) OR (cfg.bFailHigh = cfg.bFailLow) THEN
    _evaluation := E_AlarmEvaluation.InvalidConfig;
ELSIF NOT inpValid OR NOT F_IsFiniteReal(inpValue) THEN
    _evaluation := E_AlarmEvaluation.InvalidInput;
ELSIF cfg.bFailHigh THEN _raw := inpValue > cfg.fThreshold;
ELSE _raw := inpValue < cfg.fThreshold;
END_IF;
_Evaluate(cfgCommon := cfg.common, bRawCondition := _raw, evaluation := _evaluation, resetTiming := _criteriaChanged);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
