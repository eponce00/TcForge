<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1"><POU Name="FB_OperatorMailbox" Id="{fe09d54f-b6b9-4270-a591-fdee80a244ad}"><Declaration><![CDATA[// One pending command, eight bounded result records. All RPC access uses TestAndSet.
// The caller supplies a nonzero request ID unique across clients and PLC restarts.
// This volatile mailbox is not a durable delivery or exactly-once service.
FUNCTION_BLOCK FB_OperatorMailbox
VAR_OUTPUT
    ownerTask : DINT;
    lastExecutionTask : DINT;
    ownershipConflict : BOOL;
END_VAR
VAR
    _lock : BOOL;
    _records : ARRAY[1..8] OF ST_OperatorCommandRecord;
    _next : UINT := 1;
    _pending : UINT;
    _executing : UINT;
    _cancelNormal : BOOL;
    _cancelSetOff : BOOL;
END_VAR]]></Declaration><Implementation><ST><![CDATA[// Infrastructure methods only; the device body owns consumption.]]></ST></Implementation><Method Name="Priority" Id="{f6b879c1-9e3f-4109-959e-420150f09bfc}"><Declaration><![CDATA[METHOD PRIVATE Priority : UINT
VAR_INPUT command : E_OperatorCommand; END_VAR]]></Declaration><Implementation><ST><![CDATA[CASE command OF
E_OperatorCommand.Abort, E_OperatorCommand.ForceSafe: Priority := 4;
E_OperatorCommand.Stop, E_OperatorCommand.SetOff: Priority := 3;
E_OperatorCommand.Reset: Priority := 2;
E_OperatorCommand.Ack, E_OperatorCommand.SetValue, E_OperatorCommand.SetOn,
E_OperatorCommand.Advance, E_OperatorCommand.Retract, E_OperatorCommand.Home,
E_OperatorCommand.Pause, E_OperatorCommand.Proceed, E_OperatorCommand.Retry,
E_OperatorCommand.Start: Priority := 1;
ELSE Priority := 0;
END_CASE;]]></ST></Implementation></Method>
<Method Name="Submit" Id="{6512d750-96a9-4a60-9824-7f8f2d5ac210}"><Declaration><![CDATA[METHOD PUBLIC Submit : E_RpcMethodResponse
VAR_INPUT requestId : ULINT; command : E_OperatorCommand; value : REAL; END_VAR
VAR i : UINT; priorityValue : UINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[Submit := E_RpcMethodResponse.REJECTED_INVALID_PARAMETER;
priorityValue := Priority(command);
IF requestId = 0 OR priorityValue = 0 THEN RETURN; END_IF;
IF command = E_OperatorCommand.SetValue THEN
    IF NOT F_IsFiniteReal(value) THEN RETURN; END_IF;
END_IF;
Submit := E_RpcMethodResponse.REJECTED_BUSY;
IF NOT Tc2_System.TestAndSet(_lock) THEN RETURN; END_IF;
IF ownershipConflict THEN
    Submit := E_RpcMethodResponse.REJECTED_WRONG_TASK;
ELSIF ownerTask = 0 THEN
    Submit := E_RpcMethodResponse.REJECTED_NOT_READY;
ELSE
    FOR i := 1 TO 8 DO
        IF _records[i].requestId = requestId THEN
            Submit := E_RpcMethodResponse.REJECTED_DUPLICATE_REQUEST;
            _lock := FALSE; RETURN;
        END_IF;
    END_FOR;
    IF NOT ((_cancelNormal AND priorityValue < 3) OR (_cancelSetOff AND command = E_OperatorCommand.SetOff)) THEN
        IF _pending = 0 OR_ELSE priorityValue > Priority(_records[_pending].command) THEN
            IF _pending <> 0 THEN _records[_pending].result := E_RpcMethodResponse.CANCELLED; END_IF;
            _records[_next].requestId := requestId;
            _records[_next].command := command;
            _records[_next].value := value;
            _records[_next].result := E_RpcMethodResponse.QUEUED;
            _pending := _next;
            _next := _next MOD 8 + 1;
            Submit := E_RpcMethodResponse.QUEUED;
        END_IF;
    END_IF;
END_IF;
_lock := FALSE;]]></ST></Implementation></Method>
<Method Name="GetResult" Id="{308f1c11-8444-4d1b-91cf-ba52a12f5a83}"><Declaration><![CDATA[METHOD PUBLIC GetResult : E_RpcMethodResponse
VAR_INPUT requestId : ULINT; END_VAR
VAR i : UINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[GetResult := E_RpcMethodResponse.REJECTED_INVALID_PARAMETER;
IF requestId = 0 THEN RETURN; END_IF;
GetResult := E_RpcMethodResponse.REJECTED_BUSY;
IF NOT Tc2_System.TestAndSet(_lock) THEN RETURN; END_IF;
GetResult := E_RpcMethodResponse.REJECTED_UNKNOWN_REQUEST;
FOR i := 1 TO 8 DO
    IF _records[i].requestId = requestId THEN GetResult := _records[i].result; EXIT; END_IF;
END_FOR;
_lock := FALSE;]]></ST></Implementation></Method>
<Method Name="CancelNormal" Id="{aa9a8b51-bb53-4baf-9d70-ec33c6a6b9f9}"><Declaration><![CDATA[METHOD PUBLIC CancelNormal
VAR_INPUT
    // SetOff can energize an inverted output; configuration invalidation cancels it too.
    includeSetOff : BOOL := FALSE;
END_VAR]]></Declaration><Implementation><ST><![CDATA[// Owning-task-only barrier. BOOL store is atomic; BeginConsume reconciles under the lock.
// A concurrent submission either sees this barrier or is cancelled before consumption.
_cancelNormal := TRUE;
IF includeSetOff THEN _cancelSetOff := TRUE; END_IF;]]></ST></Implementation></Method>
<Method Name="BeginConsume" Id="{54547d7a-63d3-4344-8e04-62b5da92867e}"><Declaration><![CDATA[METHOD PUBLIC BeginConsume : BOOL
VAR_OUTPUT command : E_OperatorCommand; value : REAL; END_VAR
VAR current : DINT; END_VAR]]></Declaration><Implementation><ST><![CDATA[BeginConsume := FALSE;
current := Tc2_System.GETCURTASKINDEXEX();
IF current <= 0 THEN RETURN; END_IF;
IF NOT Tc2_System.TestAndSet(_lock) THEN RETURN; END_IF;
IF ownerTask = 0 THEN ownerTask := current; END_IF;
IF current <> ownerTask THEN ownershipConflict := TRUE; END_IF;
IF ownershipConflict THEN
    IF _pending <> 0 THEN _records[_pending].result := E_RpcMethodResponse.CANCELLED; _pending := 0; END_IF;
    _lock := FALSE; RETURN;
END_IF;
IF _cancelNormal OR _cancelSetOff THEN
    IF _pending <> 0 THEN
        IF (_cancelNormal AND Priority(_records[_pending].command) < 3) OR
           (_cancelSetOff AND _records[_pending].command = E_OperatorCommand.SetOff) THEN
            _records[_pending].result := E_RpcMethodResponse.CANCELLED; _pending := 0;
        END_IF;
    END_IF;
    _cancelNormal := FALSE;
    _cancelSetOff := FALSE;
END_IF;
IF _pending = 0 THEN _lock := FALSE; RETURN; END_IF;
_executing := _pending; _pending := 0;
command := _records[_executing].command; value := _records[_executing].value;
BeginConsume := TRUE;
// Keep the lock through the bounded owner dispatch. RPC callers return BUSY; none wait.
// Caller MUST pair every TRUE result with EndConsume, including rejected commands.]]></ST></Implementation></Method>
<Method Name="EndConsume" Id="{d51edee6-e06c-423d-a690-955a85083a1f}"><Declaration><![CDATA[METHOD PUBLIC EndConsume
VAR_INPUT result : E_RpcMethodResponse; END_VAR]]></Declaration><Implementation><ST><![CDATA[IF _executing = 0 THEN RETURN; END_IF;
_records[_executing].result := result;
lastExecutionTask := Tc2_System.GETCURTASKINDEXEX();
_executing := 0;
_lock := FALSE;]]></ST></Implementation></Method>
</POU></TcPlcObject>
