<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="FB_TwoPosActuator" Id="{a1234567-1234-1234-1234-123456789007}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA' := '1'}
FUNCTION_BLOCK FB_TwoPosActuator EXTENDS FB_DeviceBase
VAR_INPUT
    {attribute 'OPC.UA.DA' := '0'}
    inAdvanced : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    inRetracted : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    cfg : ST_TwoPosActuator_Cfg;
    cfgAdvancePermissives : ST_Permissive_Config;
    cfgRetractPermissives : ST_Permissive_Config;
END_VAR

VAR_OUTPUT
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    outAdvance : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    outRetract : BOOL;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    sts : ST_TwoPosActuator_Sts;
END_VAR

VAR
    _configurationKnown : BOOL;
    _lastConfiguration : ST_TwoPosActuator_Cfg;
    _inhibited : BOOL := TRUE;
    _abortPending : BOOL;
    _advancedFeedback : BOOL;
    _retractedFeedback : BOOL;

    // Composed permissive handlers (visible on OPC under the FB instance).
    advancePermissives : FB_Permissives;
    retractPermissives : FB_Permissives;

    // Internal state tracking
    {attribute 'OPC.UA.DA' := '0'}
    currentState : E_TwoPosActuator_State := E_TwoPosActuator_State.Undefined;
    {attribute 'OPC.UA.DA' := '0'}
    previousState : E_TwoPosActuator_State;

    // Motion timers
    {attribute 'OPC.UA.DA' := '0'}
    advanceTimer : TON;
    {attribute 'OPC.UA.DA' := '0'}
    retractTimer : TON;

    // Edge detection for one-shot outputs
    {attribute 'OPC.UA.DA' := '0'}
    rTrigAdvanced : R_TRIG;
    {attribute 'OPC.UA.DA' := '0'}
    rTrigRetracted : R_TRIG;

    {attribute 'OPC.UA.DA' := '0'}
    bothFeedbackActive : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_SyncConfiguration();
_ProcessOperatorCommands();
//-----------------------------------------------------------------------------
// Cyclic monitoring. Commands are issued via methods; this body only watches
// for completion/faults and keeps sts in sync. Fault latching + last-fault
// history live in FB_DeviceBase (_Raise / _ClearFault).
//-----------------------------------------------------------------------------
_advancedFeedback := inAdvanced;
_retractedFeedback := inRetracted;
advancePermissives(cfg := cfgAdvancePermissives);
retractPermissives(cfg := cfgRetractPermissives);

bothFeedbackActive := _advancedFeedback AND _retractedFeedback;

previousState := currentState;
IF (currentState = E_TwoPosActuator_State.Advancing AND NOT advancePermissives.sts.bOK) OR
   (currentState = E_TwoPosActuator_State.Retracting AND NOT retractPermissives.sts.bOK) THEN
    _Raise(code := E_TwoPosActuator_Fault.PermissivesNotOK, source := 'PERMISSIVES', reason := 'Travel condition missing or false');
    currentState := E_TwoPosActuator_State.Fault;
END_IF;

CASE currentState OF

    E_TwoPosActuator_State.Undefined:
        outAdvance := FALSE;
        outRetract := FALSE;

        IF bothFeedbackActive THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.BothFeedbackOn,
                source := 'FEEDBACK',
                reason := 'Both advanced and retracted feedback asserted simultaneously'
            );
        ELSIF _advancedFeedback AND NOT _retractedFeedback THEN
            currentState := E_TwoPosActuator_State.Advanced;
        ELSIF _retractedFeedback AND NOT _advancedFeedback THEN
            currentState := E_TwoPosActuator_State.Retracted;
        END_IF;

    E_TwoPosActuator_State.Retracted:
        IF cfg.holdAtRetracted THEN
            outRetract := TRUE;
        ELSE
            outRetract := FALSE;
        END_IF;
        outAdvance := FALSE;

        IF bothFeedbackActive THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.BothFeedbackOn,
                source := 'FEEDBACK',
                reason := 'Both advanced and retracted feedback asserted simultaneously'
            );
        ELSIF NOT _retractedFeedback THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.UndefinedState,
                source := 'FEEDBACK',
                reason := 'Retracted feedback lost after reaching position'
            );
        END_IF;

    E_TwoPosActuator_State.Advancing:
        outAdvance := TRUE;
        outRetract := FALSE;
        advanceTimer(IN := TRUE, PT := DINT_TO_TIME(INT_TO_DINT(cfg.advTimeoutS) * 1000));

        IF _advancedFeedback AND NOT _retractedFeedback THEN
            currentState := E_TwoPosActuator_State.Advanced;
            advanceTimer(IN := FALSE);
        ELSIF advanceTimer.Q THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.AdvanceTimeout,
                source := 'MOTION',
                reason := 'inFbkAdvanced did not assert within advTimeoutS'
            );
            advanceTimer(IN := FALSE);
        ELSIF bothFeedbackActive THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.BothFeedbackOn,
                source := 'FEEDBACK',
                reason := 'Both advanced and retracted feedback asserted while advancing'
            );
            advanceTimer(IN := FALSE);
        ELSIF NOT advancePermissives.sts.bOK THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.PermissivesNotOK,
                source := 'PERMISSIVES',
                reason := 'Advance permissive dropped during travel'
            );
            advanceTimer(IN := FALSE);
        END_IF;

    E_TwoPosActuator_State.Advanced:
        IF cfg.holdAtAdvanced THEN
            outAdvance := TRUE;
        ELSE
            outAdvance := FALSE;
        END_IF;
        outRetract := FALSE;

        IF bothFeedbackActive THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.BothFeedbackOn,
                source := 'FEEDBACK',
                reason := 'Both advanced and retracted feedback asserted simultaneously'
            );
        ELSIF NOT _advancedFeedback THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.UndefinedState,
                source := 'FEEDBACK',
                reason := 'Advanced feedback lost after reaching position'
            );
        END_IF;

    E_TwoPosActuator_State.Retracting:
        outRetract := TRUE;
        outAdvance := FALSE;
        retractTimer(IN := TRUE, PT := DINT_TO_TIME(INT_TO_DINT(cfg.retTimeoutS) * 1000));

        IF _retractedFeedback AND NOT _advancedFeedback THEN
            currentState := E_TwoPosActuator_State.Retracted;
            retractTimer(IN := FALSE);
        ELSIF retractTimer.Q THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.RetractTimeout,
                source := 'MOTION',
                reason := 'inFbkRetracted did not assert within retTimeoutS'
            );
            retractTimer(IN := FALSE);
        ELSIF bothFeedbackActive THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.BothFeedbackOn,
                source := 'FEEDBACK',
                reason := 'Both advanced and retracted feedback asserted while retracting'
            );
            retractTimer(IN := FALSE);
        ELSIF NOT retractPermissives.sts.bOK THEN
            currentState := E_TwoPosActuator_State.Fault;
            _Raise(
                code   := E_TwoPosActuator_Fault.PermissivesNotOK,
                source := 'PERMISSIVES',
                reason := 'Retract permissive dropped during travel'
            );
            retractTimer(IN := FALSE);
        END_IF;

    E_TwoPosActuator_State.Fault:
        outAdvance := FALSE;
        outRetract := FALSE;
        advanceTimer(IN := FALSE);
        retractTimer(IN := FALSE);
END_CASE;

IF cfg.advTimeoutS <= 0 OR cfg.retTimeoutS <= 0 THEN
    _Raise(code := E_TwoPosActuator_Fault.BadConfig, source := 'CONFIG', reason := 'Travel timeouts must be positive');
    currentState := E_TwoPosActuator_State.Fault;
END_IF;
IF NOT _inhibited AND ((currentState = E_TwoPosActuator_State.Advanced AND cfg.holdAtAdvanced AND NOT advancePermissives.sts.bOK) OR
   (currentState = E_TwoPosActuator_State.Retracted AND cfg.holdAtRetracted AND NOT retractPermissives.sts.bOK)) THEN
    _Raise(code := E_TwoPosActuator_Fault.PermissivesNotOK, source := 'PERMISSIVES', reason := 'Hold permissive missing');
    currentState := E_TwoPosActuator_State.Fault;
END_IF;
// Apply outputs from the FINAL state so a trip removes coils in the detecting scan.
IF IsFaulted() OR _inhibited OR currentState = E_TwoPosActuator_State.Undefined THEN
    outAdvance := FALSE; outRetract := FALSE;
ELSE
    outAdvance := currentState = E_TwoPosActuator_State.Advancing OR (currentState = E_TwoPosActuator_State.Advanced AND cfg.holdAtAdvanced);
    outRetract := currentState = E_TwoPosActuator_State.Retracting OR (currentState = E_TwoPosActuator_State.Retracted AND cfg.holdAtRetracted);
END_IF;

//-------------------------------------------------------------------------
// Device-specific status
// Abort priority lasts through application of the next scan.
_abortPending := FALSE;
//-------------------------------------------------------------------------
sts.state        := currentState;
sts.advanced  := (currentState = E_TwoPosActuator_State.Advanced);
sts.retracted := (currentState = E_TwoPosActuator_State.Retracted);
sts.moving    := (currentState = E_TwoPosActuator_State.Advancing) OR
                    (currentState = E_TwoPosActuator_State.Retracting);

rTrigAdvanced(CLK := sts.advanced);
sts.osAdvanced := rTrigAdvanced.Q;

rTrigRetracted(CLK := sts.retracted);
sts.osRetracted := rTrigRetracted.Q;

//-------------------------------------------------------------------------
// Common header — delegated to the base; fault/source/timestamps filled from
// the inherited fault book-keeping and source lock. busy mirrors sts.moving.
//-------------------------------------------------------------------------
_UpdateHeader(
    header      := sts.header,
    stateString := _StateToString(state := currentState),
    busy     := sts.moving
);]]></ST>
    </Implementation>

    <Folder Name="Operator RPC" Id="{676baf77-f552-5699-bc5e-a7b744237b85}" />
    <Folder Name="Program Commands" Id="{f0a10001-0001-0001-0001-000000000001}" />
    <Folder Name="Configuration" Id="{ab2b7c44-ee37-5d47-864e-e6603f0abef2}" />
    <Folder Name="Protected" Id="{1a462791-e6e0-5098-b084-b7593d412220}" />
    <Folder Name="Private" Id="{f0a10002-0001-0001-0001-000000000002}" />
<Method Name="Advance" Id="{a1234567-1234-1234-1234-12345678A001}" FolderPath="Program Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Advance : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Advance := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Advance <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
_SyncConfiguration();
IF _abortPending THEN
    Advance := E_RpcMethodResponse.REJECTED_INTERLOCKED;
    RETURN;
END_IF;
Advance := F_ValidateRequester(eRequester, bSourceLockedToProg, IsFaulted());
IF Advance <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
IF currentState = E_TwoPosActuator_State.Retracting THEN
    Advance := E_RpcMethodResponse.REJECTED_WRONG_STATE;
    RETURN;
END_IF;

IF (currentState = E_TwoPosActuator_State.Advanced AND NOT _inhibited) OR currentState = E_TwoPosActuator_State.Advancing THEN
    Advance := E_RpcMethodResponse.REJECTED_ALREADY_AT_TARGET;
    RETURN;
END_IF;

IF NOT advancePermissives.sts.bOK THEN
    Advance := E_RpcMethodResponse.REJECTED_PERMISSIVE_NOT_MET;
    RETURN;
END_IF;

_inhibited := FALSE;
currentState := E_TwoPosActuator_State.Advancing;
advanceTimer(IN := FALSE);
_AcceptCommand(eRequester := eRequester);
Advance := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retract" Id="{a1234567-1234-1234-1234-12345678A002}" FolderPath="Program Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Retract : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Retract := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Retract <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
_SyncConfiguration();
IF _abortPending THEN
    Retract := E_RpcMethodResponse.REJECTED_INTERLOCKED;
    RETURN;
END_IF;
Retract := F_ValidateRequester(eRequester, bSourceLockedToProg, IsFaulted());
IF Retract <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
IF currentState = E_TwoPosActuator_State.Advancing THEN
    Retract := E_RpcMethodResponse.REJECTED_WRONG_STATE;
    RETURN;
END_IF;

IF (currentState = E_TwoPosActuator_State.Retracted AND NOT _inhibited) OR currentState = E_TwoPosActuator_State.Retracting THEN
    Retract := E_RpcMethodResponse.REJECTED_ALREADY_AT_TARGET;
    RETURN;
END_IF;

IF NOT retractPermissives.sts.bOK THEN
    Retract := E_RpcMethodResponse.REJECTED_PERMISSIVE_NOT_MET;
    RETURN;
END_IF;

_inhibited := FALSE;
currentState := E_TwoPosActuator_State.Retracting;
retractTimer(IN := FALSE);
_AcceptCommand(eRequester := eRequester);
Retract := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Abort" Id="{a1234567-1234-1234-1234-12345678A003}" FolderPath="Program Commands\">
      <Declaration><![CDATA[// Safety command — always accepted (bypasses source lock and fault check).
// De-energizes both valves and returns to Undefined for re-evaluation.
METHOD PUBLIC Abort : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Abort := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Abort <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
_SyncConfiguration();
_operatorMailbox.CancelNormal();
outAdvance := FALSE;
outRetract := FALSE;
advanceTimer(IN := FALSE);
retractTimer(IN := FALSE);
_abortPending := TRUE;
_inhibited := TRUE;
outAdvance := FALSE; outRetract := FALSE;
currentState := E_TwoPosActuator_State.Undefined;
_AcceptCommand(eRequester := eRequester);
Abort := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{a1234567-1234-1234-1234-12345678A004}" FolderPath="Program Commands\">
      <Declaration><![CDATA[// Safety invariant: Reset is always accepted from any requester regardless
// of source lock or current state. Clears the active fault via the base and
// returns the device to Undefined so the body can re-evaluate feedback.
METHOD PUBLIC Reset : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Reset := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Reset <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
_SyncConfiguration();
_operatorMailbox.CancelNormal();
SUPER^.Reset(eRequester := eRequester);

_abortPending := TRUE;
_inhibited := TRUE;
outAdvance := FALSE; outRetract := FALSE;
currentState := E_TwoPosActuator_State.Undefined;
outAdvance := FALSE;
outRetract := FALSE;
advanceTimer(IN := FALSE);
retractTimer(IN := FALSE);
Reset := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResolveFaultString" Id="{a1234567-1234-1234-1234-12345678A005}" FolderPath="Private\">
      <Declaration><![CDATA[// Translates this device's fault enum to human-readable text.
// Called by FB_DeviceBase to populate sts.header.faultString / lastFaultString.
METHOD PROTECTED ResolveFaultString : STRING(79)
VAR_INPUT
    code : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE code OF
    E_TwoPosActuator_Fault.BadConfig: ResolveFaultString := 'Actuator timeouts must be positive';
    E_TwoPosActuator_Fault.None:                ResolveFaultString := 'No Fault';
    E_TwoPosActuator_Fault.AdvanceTimeout:      ResolveFaultString := 'Advance Timeout';
    E_TwoPosActuator_Fault.RetractTimeout:      ResolveFaultString := 'Retract Timeout';
    E_TwoPosActuator_Fault.BothFeedbackOn:      ResolveFaultString := 'Both Feedbacks Active';
    E_TwoPosActuator_Fault.UndefinedState:      ResolveFaultString := 'Position Undefined';
    E_TwoPosActuator_Fault.PermissivesNotOK:    ResolveFaultString := 'Permissives Not OK';
    E_TwoPosActuator_Fault.ConflictingCommands: ResolveFaultString := 'Conflicting Commands';
    E_TwoPosActuator_Fault.NoFeedback:          ResolveFaultString := 'No Position Feedback';
ELSE
    ResolveFaultString := 'Unknown Fault';
END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_StateToString" Id="{a1234567-1234-1234-1234-12345678A006}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE _StateToString : STRING(31)
VAR_INPUT
    state : E_TwoPosActuator_State;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE state OF
    E_TwoPosActuator_State.Undefined:  _StateToString := 'Undefined';
    E_TwoPosActuator_State.Retracted:  _StateToString := 'Retracted';
    E_TwoPosActuator_State.Advancing:  _StateToString := 'Advancing';
    E_TwoPosActuator_State.Advanced:   _StateToString := 'Advanced';
    E_TwoPosActuator_State.Retracting: _StateToString := 'Retracting';
    E_TwoPosActuator_State.Fault:      _StateToString := 'Fault';
ELSE
    _StateToString := 'Unknown';
END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorAdvance" Id="{1b88e6f8-21de-4249-9afc-0846301a1c78}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorAdvance : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[OperatorAdvance := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Advance, value := 0.0);]]></ST></Implementation>
    </Method>
    <Method Name="OperatorRetract" Id="{f0bb6e07-590f-4aee-a079-767877cae79a}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorRetract : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[OperatorRetract := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Retract, value := 0.0);]]></ST></Implementation>
    </Method>
    <Method Name="OperatorAbort" Id="{3880eb4d-1dce-4b8d-8dcb-1060ad2418f5}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorAbort : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[OperatorAbort := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Abort, value := 0.0);]]></ST></Implementation>
    </Method>
    <Method Name="OperatorReset" Id="{1b513401-3042-4e49-84ad-a734b0072144}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorReset : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[OperatorReset := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Reset, value := 0.0);]]></ST></Implementation>
    </Method>
<Method Name="MapAdvanceCondition" Id="{847b3518-70c7-4d13-95ad-c29cc84da555}" FolderPath="Configuration\"><Declaration><![CDATA[METHOD PUBLIC MapAdvanceCondition
VAR_INPUT
    bitIndex : UDINT;
    bGood : BOOL;
END_VAR]]></Declaration><Implementation><ST><![CDATA[advancePermissives.MapInput(bitIndex := bitIndex, inputValue := bGood);]]></ST></Implementation></Method>
<Method Name="MapRetractCondition" Id="{0680c05a-5f43-4f65-ba99-35cba55dc483}" FolderPath="Configuration\"><Declaration><![CDATA[METHOD PUBLIC MapRetractCondition
VAR_INPUT
    bitIndex : UDINT;
    bGood : BOOL;
END_VAR]]></Declaration><Implementation><ST><![CDATA[retractPermissives.MapInput(bitIndex := bitIndex, inputValue := bGood);]]></ST></Implementation></Method>
    <Method Name="_DispatchOperatorCommand" Id="{532e7d41-7b82-4578-a7af-46a3a1f44593}" FolderPath="Protected\"><Declaration><![CDATA[METHOD PROTECTED _DispatchOperatorCommand : E_RpcMethodResponse
VAR_INPUT command : E_OperatorCommand; value : REAL; END_VAR]]></Declaration><Implementation><ST><![CDATA[CASE command OF
E_OperatorCommand.Advance: _DispatchOperatorCommand := THIS^.Advance(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Retract: _DispatchOperatorCommand := THIS^.Retract(eRequester := E_Requester.OPERATOR);
E_OperatorCommand.Abort: _DispatchOperatorCommand := THIS^.Abort(eRequester := E_Requester.OPERATOR);
ELSE _DispatchOperatorCommand := SUPER^._DispatchOperatorCommand(command := command, value := value);
END_CASE;]]></ST></Implementation></Method>
<Method Name="_SyncConfiguration" Id="{93100aa1-f8e1-4bf7-8a93-e78ed8681240}" FolderPath="Private\"><Declaration><![CDATA[METHOD PRIVATE _SyncConfiguration]]></Declaration><Implementation><ST><![CDATA[// Configuration is owned by the same cyclic task as this device.
// The first observation establishes a baseline and preserves first-scan commands.
IF NOT _configurationKnown THEN
    _lastConfiguration := cfg;
    _configurationKnown := TRUE;
    RETURN;
END_IF;
IF cfg.advTimeoutS <> _lastConfiguration.advTimeoutS OR
   cfg.retTimeoutS <> _lastConfiguration.retTimeoutS OR
   cfg.holdAtAdvanced <> _lastConfiguration.holdAtAdvanced OR
   cfg.holdAtRetracted <> _lastConfiguration.holdAtRetracted THEN
    // Discard old operating intent before interpreting it under a new configuration.
    _operatorMailbox.CancelNormal();
    _inhibited := TRUE;
    advanceTimer(IN := FALSE);
    retractTimer(IN := FALSE);
    outAdvance := FALSE;
    outRetract := FALSE;
    // Re-observe position without retaining travel or hold intent; faults remain latched.
    currentState := E_TwoPosActuator_State.Undefined;
END_IF;
_lastConfiguration := cfg;]]></ST></Implementation></Method>
