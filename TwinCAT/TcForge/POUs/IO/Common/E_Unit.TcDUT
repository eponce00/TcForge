<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <DUT Name="E_Unit" Id="{c0000030-0000-0000-0000-000000000002}">
    <Declaration><![CDATA[// Display metadata for analog IO. The value is already scaled by the owning
// device; this enum does not convert or validate engineering units. An HMI may
// map the enum to a symbol (for example MILLIMETER -> mm).
//
// Keep explicit numeric values stable after publication because OPC clients may
// store them. Extend for machine-relevant measurements; never repurpose a code.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_Unit :
(
    // A channel whose display unit has not been configured.
    UNSPECIFIED                   := 0,

    // Ratio and discrete quantity.
    PERCENT                       := 1,     // %
    COUNT                         := 2,     // pieces / cycles

    // Position, orientation, velocity and acceleration.
    MILLIMETER                    := 3,     // mm
    MICROMETER                    := 4,     // um
    DEGREE                        := 5,     // angular degrees
    MILLIMETER_PER_SECOND         := 6,     // mm/s
    MILLIMETER_PER_SECOND_SQUARED := 7,     // mm/s^2
    RPM                           := 8,     // revolutions/minute

    // Force, torque, mass and pneumatic pressure.
    NEWTON                        := 9,     // N
    NEWTON_METER                  := 10,    // N m
    GRAM                          := 11,    // g
    KILOGRAM                      := 12,    // kg
    BAR                           := 13,    // bar
    KILOPASCAL                    := 14,    // kPa

    // Temperature and electrical measurements.
    DEGREE_CELSIUS                := 15,    // deg C
    DEGREE_FAHRENHEIT             := 16,    // deg F
    VOLTS                         := 17,    // V
    AMPS                          := 18,    // A
    WATT                          := 19,    // W
    HERTZ                         := 20,    // Hz

    // Cycle measurements and sensor-reported durations.
    SECOND                        := 21,    // s
    MILLISECOND                   := 22     // ms
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
