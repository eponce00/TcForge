<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="FB_LPF_FirstOrder_IIR" Id="{c0000031-0000-0000-0000-000000000002}" SpecialFunc="None">
    <Declaration><![CDATA[// First-order IIR low-pass filter. Exponential smoothing of the form
//     y[n] = y[n-1] + alpha * (x[n] - y[n-1])
// with alpha = dt / (tau + dt). Tau is the 63.2 % rise-time constant.
//
// When dt or tau are effectively zero the filter passes the input through
// unchanged and raises bError. _prevOutput_sync persists across scans so the
// filter state carries between calls; it is ordinary non-retained state.
FUNCTION_BLOCK FB_LPF_FirstOrder_IIR
VAR_INPUT
    fInput  : LREAL;    // input sample
    fDt     : LREAL;    // time since previous call [s]
    fTau    : LREAL;    // time constant [s]
END_VAR
VAR_OUTPUT
    fOutput : LREAL;    // filtered output
    bError  : BOOL;     // TRUE when fDt or fTau were too small to filter
END_VAR
VAR
    _filtAlpha        : LREAL;
    _prevOutput_sync  : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reject nonfinite values before they can poison retained recurrence history.
IF NOT F_IsFiniteLReal(value := _prevOutput_sync) THEN
    _prevOutput_sync := 0.0;
END_IF;
IF NOT F_IsFiniteLReal(value := fInput) OR NOT F_IsFiniteLReal(value := fDt) OR NOT F_IsFiniteLReal(value := fTau) THEN
    fOutput := _prevOutput_sync;
    bError := TRUE;
    RETURN;
END_IF;
// Preserve the documented finite zero/negative timing pass-through behavior.
IF fDt < 1E-38 OR fTau < 1E-38 THEN
    fOutput := fInput;
    bError  := TRUE;
    _prevOutput_sync := fOutput;
    RETURN;
END_IF;

bError := FALSE;

// Ratio form avoids overflow in tau + dt; weighted sum avoids x - previous.
IF fDt >= fTau THEN
    _filtAlpha := 1.0 / (1.0 + fTau / fDt);
ELSE
    _filtAlpha := fDt / fTau;
    _filtAlpha := _filtAlpha / (1.0 + _filtAlpha);
END_IF;
fOutput := (1.0 - _filtAlpha) * _prevOutput_sync + _filtAlpha * fInput;

_prevOutput_sync := fOutput;]]></ST>
    </Implementation>

    <Folder Name="Configuration" Id="{fa738efb-f7cf-523a-9b28-10c58d04edb5}" />
<Method Name="Seed" Id="{f1b46e49-0a18-4da1-bcc4-f06962221f10}" FolderPath="Configuration\"><Declaration><![CDATA[// Explicit conditioning lifecycle reset, invoked only by the owning task.
// Invalid seeds leave existing history and output unchanged.
METHOD PUBLIC Seed : BOOL
VAR_INPUT value : LREAL; END_VAR]]></Declaration><Implementation><ST><![CDATA[Seed := F_IsFiniteLReal(value := value);
IF NOT Seed THEN RETURN; END_IF;
_prevOutput_sync := value;
fOutput := value;
bError := FALSE;]]></ST></Implementation></Method>
    <LineIds Name="FB_LPF_FirstOrder_IIR">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
