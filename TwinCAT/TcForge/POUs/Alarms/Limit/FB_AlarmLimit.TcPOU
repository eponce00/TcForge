<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_AlarmLimit" Id="{a0200003-0000-0000-0000-000000000001}" SpecialFunc="None">
    <Declaration><![CDATA[// Four-level limit ladder (HiHi / Hi / Lo / LoLo) built on four composed
// FB_AlarmThreshold instances. Each level has its own full config; delays,
// severity, and ack behaviour are set per level.
//
// Flood suppression: HiHi hides Hi, LoLo hides Lo on the rollup flags. The
// raw sub-statuses (HiHi / Hi / Lo / LoLo) are still exposed for forensics.
//
// Ack() cascades to every sub-alarm. LockSource() cascades identically, so the
// composite honours a single source-lock decision.
//
// Typical config (alongside an analog input):
//   cfg.HiHi.common.bEnable := TRUE; cfg.HiHi.fThreshold := 110.0;
//   cfg.HiHi.bFailHigh := TRUE;      cfg.HiHi.common.eSeverity := E_AlarmSeverity.CRITICAL;
//   cfg.Hi.common.bEnable   := TRUE; cfg.Hi.fThreshold   := 100.0;
//   cfg.Hi.bFailHigh   := TRUE;      cfg.Hi.common.eSeverity   := E_AlarmSeverity.WARNING;
//   cfg.Lo.common.bEnable   := TRUE; cfg.Lo.fThreshold   :=  20.0;
//   cfg.Lo.bFailLow    := TRUE;      cfg.Lo.common.eSeverity   := E_AlarmSeverity.WARNING;
//   cfg.LoLo.common.bEnable := TRUE; cfg.LoLo.fThreshold :=  10.0;
//   cfg.LoLo.bFailLow  := TRUE;      cfg.LoLo.common.eSeverity := E_AlarmSeverity.CRITICAL;
{attribute 'OPC.UA.DA' := '1'}
FUNCTION_BLOCK FB_AlarmLimit IMPLEMENTS I_Alarm
VAR_INPUT
    // Application quality gate; FALSE means no trustworthy new evidence.
    inpValid : BOOL := TRUE;
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    cfg   : ST_AlarmLimit_Cfg;

    {attribute 'OPC.UA.DA' := '0'}
    inpPv : REAL;
END_VAR
VAR_OUTPUT
    {attribute 'OPC.UA.DA' := '1'}
    {attribute 'OPC.UA.DA.Access' := '1'}
    sts : ST_AlarmLimit_Sts;
END_VAR
VAR
    {attribute 'OPC.UA.DA' := '0'}
    {attribute 'OPC.UA.DA' := '0'}
    _operatorMailbox : FB_OperatorMailbox;
    _hiHi : FB_AlarmThreshold;
    _hi   : FB_AlarmThreshold;
    _lo   : FB_AlarmThreshold;
    _loLo : FB_AlarmThreshold;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_ProcessOperatorCommands();
// Push config into each sub-alarm every cycle so HMI changes take effect.
_hiHi.cfg := cfg.HiHi;
_hi.cfg   := cfg.Hi;
_lo.cfg   := cfg.Lo;
_loLo.cfg := cfg.LoLo;

_hiHi(inpValue := inpPv, inpValid := inpValid);
_hi(inpValue   := inpPv, inpValid := inpValid);
_lo(inpValue   := inpPv, inpValid := inpValid);
_loLo(inpValue := inpPv, inpValid := inpValid);

// Expose raw sub-statuses
sts.HiHi := _hiHi.sts;
sts.Hi   := _hi.sts;
sts.Lo   := _lo.sts;
sts.LoLo := _loLo.sts;

// Disabled levels do not invalidate enabled levels; all-disabled has no evaluation.
sts.evaluationState := E_AlarmEvaluation.Disabled;
IF cfg.HiHi.common.bEnable OR cfg.Hi.common.bEnable OR cfg.Lo.common.bEnable OR cfg.LoLo.common.bEnable THEN
    sts.evaluationState := E_AlarmEvaluation.Valid;
    IF sts.HiHi.enabled AND NOT sts.HiHi.valid THEN
        IF sts.evaluationState <> E_AlarmEvaluation.InvalidConfig THEN sts.evaluationState := sts.HiHi.evaluationState; END_IF;
    END_IF;
    IF sts.Hi.enabled AND NOT sts.Hi.valid THEN
        IF sts.evaluationState <> E_AlarmEvaluation.InvalidConfig THEN sts.evaluationState := sts.Hi.evaluationState; END_IF;
    END_IF;
    IF sts.Lo.enabled AND NOT sts.Lo.valid THEN
        IF sts.evaluationState <> E_AlarmEvaluation.InvalidConfig THEN sts.evaluationState := sts.Lo.evaluationState; END_IF;
    END_IF;
    IF sts.LoLo.enabled AND NOT sts.LoLo.valid THEN
        IF sts.evaluationState <> E_AlarmEvaluation.InvalidConfig THEN sts.evaluationState := sts.LoLo.evaluationState; END_IF;
    END_IF;
END_IF;
sts.valid := sts.evaluationState = E_AlarmEvaluation.Valid;

// Rollup with suppression (higher priority hides lower on same direction)
sts.hiHiActive := _hiHi.sts.active;
sts.hiActive   := _hi.sts.active   AND NOT sts.hiHiActive;
sts.loLoActive := _loLo.sts.active;
sts.loActive   := _lo.sts.active   AND NOT sts.loLoActive;

sts.anyActive := sts.hiHiActive OR sts.hiActive OR sts.loActive OR sts.loLoActive;

// Aggregate severity — highest currently-active level wins.
sts.eSeverity := E_AlarmSeverity.NONE;
IF _hiHi.sts.eSeverity > sts.eSeverity THEN sts.eSeverity := _hiHi.sts.eSeverity; END_IF;
IF _hi.sts.eSeverity   > sts.eSeverity THEN sts.eSeverity := _hi.sts.eSeverity;   END_IF;
IF _lo.sts.eSeverity   > sts.eSeverity THEN sts.eSeverity := _lo.sts.eSeverity;   END_IF;
IF _loLo.sts.eSeverity > sts.eSeverity THEN sts.eSeverity := _loLo.sts.eSeverity; END_IF;]]></ST>
    </Implementation>

    <Folder Name="Operator RPC" Id="{e048f4e6-b6a0-5fc6-97bd-0801d6a49110}" />
    <Folder Name="Program Commands" Id="{798452b2-3cac-512d-ad4b-f043e7245eb4}" />
    <Folder Name="Protected" Id="{d951c2ce-2791-553b-8f47-47b375841a6b}" />
<Method Name="_DispatchOperatorCommand" Id="{41e77b88-0904-4ba2-a2fe-fc4bae363620}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _DispatchOperatorCommand : E_RpcMethodResponse
VAR_INPUT command : E_OperatorCommand; value : REAL; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE command OF
E_OperatorCommand.Ack: _DispatchOperatorCommand := THIS^.Ack(eRequester := E_Requester.OPERATOR);
ELSE _DispatchOperatorCommand := E_RpcMethodResponse.REJECTED_INVALID_PARAMETER;
END_CASE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ProcessOperatorCommands" Id="{992ce571-3932-48c1-823c-a23fa7108f18}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED _ProcessOperatorCommands
VAR command : E_OperatorCommand; value : REAL; result : E_RpcMethodResponse; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _operatorMailbox.BeginConsume(command => command, value => value) THEN
    result := THIS^._DispatchOperatorCommand(command := command, value := value);
    _operatorMailbox.EndConsume(result := result);
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ack" Id="{a0200003-0000-0000-1000-000000000001}" FolderPath="Program Commands\">
      <Declaration><![CDATA[// Composite Ack — cascades to all four levels. Returns ACCEPTED if at least
// one level accepted; reports any source-lock rejection otherwise.
METHOD PUBLIC Ack : E_RpcMethodResponse
VAR_INPUT
    eRequester : E_Requester := E_Requester.PROG;
END_VAR
VAR
    r1, r2, r3, r4 : E_RpcMethodResponse;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reject invalid identity before any command-specific mutation.
Ack := F_ValidateRequester(eRequester := eRequester, bSourceLocked := FALSE, bFaulted := FALSE);
IF Ack <> E_RpcMethodResponse.ACCEPTED THEN RETURN; END_IF;
r1 := _hiHi.Ack(eRequester := eRequester);
r2 := _hi.Ack(eRequester   := eRequester);
r3 := _lo.Ack(eRequester   := eRequester);
r4 := _loLo.Ack(eRequester := eRequester);

IF r1 = E_RpcMethodResponse.ACCEPTED OR r2 = E_RpcMethodResponse.ACCEPTED
   OR r3 = E_RpcMethodResponse.ACCEPTED OR r4 = E_RpcMethodResponse.ACCEPTED THEN
    Ack := E_RpcMethodResponse.ACCEPTED;
ELSE
    // Every level rejected — all four reject for the same reason (source
    // lock / not latched), so returning the HiHi response is representative.
    Ack := r1;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LockSource" Id="{a0200003-0000-0000-1000-000000000002}" FolderPath="Program Commands\">
      <Declaration><![CDATA[METHOD PUBLIC LockSource : E_RpcMethodResponse
VAR_INPUT
    bLock : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_hiHi.LockSource(bLock := bLock);
_hi.LockSource(bLock   := bLock);
_lo.LockSource(bLock   := bLock);
_loLo.LockSource(bLock := bLock);
LockSource := E_RpcMethodResponse.ACCEPTED;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorAck" Id="{ade8e23b-5c25-4a4a-9bef-9c7ca753dcb3}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorAck : E_RpcMethodResponse

VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OperatorAck := _operatorMailbox.Submit(requestId := requestId, command := E_OperatorCommand.Ack, value := 0.0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorCommandResult" Id="{182a2202-4f6b-4bfe-8ef7-ac0904a8a053}" FolderPath="Operator RPC\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable' := '1'}
METHOD PUBLIC OperatorCommandResult : E_RpcMethodResponse
VAR_INPUT requestId : ULINT; END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OperatorCommandResult := _operatorMailbox.GetResult(requestId := requestId);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>